# ============================================
# Goals App — Production Environment Variables
# Copy to .env and fill in actual values
# ============================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=your_strong_mysql_password_here
DB_NAME=tasks

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=xmeng.plus,www.xmeng.plus,localhost,127.0.0.1

# --- CORS ---
CORS_EXTRA_ORIGINS=https://xmeng.plus,https://www.xmeng.plus,http://xmeng.plus,http://www.xmeng.plus

# --- DeepSeek AI ---
DEEPSEEK_API_KEY=sk-your-deepseek-key

# --- OpenAI (optional, kept for reference) ---
OPENAI_API_KEY=sk-your-openai-key

# --- Email SMTP (QQ Mail) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=970701350@qq.com
EMAIL_HOST_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=970701350@qq.com
